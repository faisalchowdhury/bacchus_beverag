# Build-time config for the deployed website (faisal6000.ssh.bd).
# Vite reads this for `npm run build`; `.env` still drives `npm run dev`.
VITE_BACKEND_BASE=http://api.bacchusbeverages.systems

# Legacy escape hatch — the UI falls back to HoneyBook copy when blank.
# The quote wizard posts to VITE_BACKEND_BASE above, so this stays empty.
VITE_QUOTE_ENDPOINT=
