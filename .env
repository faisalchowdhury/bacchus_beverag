VITE_BACKEND_BASE=http://api.bacchusbeverages.systems

# Endpoint that emails the owner a notification + copy of each submitted quote.
# Leave blank until an endpoint exists — the UI will tell clients to use HoneyBook instead.
VITE_QUOTE_ENDPOINT=

# Local dev server port. Not read at build time (production is unaffected).
# 6000 is blocked outright by Chrome/Firefox as an "unsafe port" (ERR_UNSAFE_PORT),
# so local dev needs a different one — 5173 is Vite's own long-standing default.
DEV_PORT=5173
